{% load static %}

<aside class="sidebar" id="sidebar">

  <!-- Brand -->
  <div class="sidebar-brand">
    <div class="brand-icon">💰</div>
    <div class="brand-name">
      BUDGETBRIDGE
      <span>Management System</span>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="sidebar-nav" role="navigation" aria-label="Main navigation">

    <!-- Main -->
    <div class="nav-section">Main</div>

    <div class="nav-item">
      <a href="{% url 'dashboard' %}" class="nav-link {% if request.resolver_match.url_name == 'dashboard' %}active{% endif %}">
        <span class="nav-icon">📊</span>
        Dashboard
      </a>
    </div>

    <!-- Projects -->
    <div class="nav-section">Projects</div>

    <div class="nav-item">
      <a href="{% url 'projects:list' %}" class="nav-link {% if 'projects' in request.path %}active{% endif %}">
        <span class="nav-icon">📁</span>
        Projects
      </a>
    </div>

    <div class="nav-item">
      <a href="{% url 'projects:budget' %}" class="nav-link {% if 'budget' in request.path %}active{% endif %}">
        <span class="nav-icon">🎯</span>
        Budget Control
      </a>
    </div>

    <!-- Finance -->
    <div class="nav-section">Finance</div>

    <div class="nav-item">
      <a href="{% url 'expenses:list' %}" class="nav-link {% if 'expenses' in request.path %}active{% endif %}">
        <span class="nav-icon">🧾</span>
        Expenses
        {# Pending approvals badge — pass from context #}
        {% if pending_expenses_count %}
          <span class="nav-badge">{{ pending_expenses_count }}</span>
        {% endif %}
      </a>
    </div>

    <div class="nav-item">
      <a href="{% url 'invoices:list' %}" class="nav-link {% if 'invoices' in request.path %}active{% endif %}">
        <span class="nav-icon">📄</span>
        Invoices
        {% if overdue_invoices_count %}
          <span class="nav-badge">{{ overdue_invoices_count }}</span>
        {% endif %}
      </a>
    </div>

    <div class="nav-item">
      <a href="{% url 'payments:list' %}" class="nav-link {% if 'payments' in request.path %}active{% endif %}">
        <span class="nav-icon">💳</span>
        Payments
      </a>
    </div>

    <!-- HR & Payroll -->
    <div class="nav-section">HR & Payroll</div>

    <div class="nav-item">
      <a href="{% url 'payroll:list' %}" class="nav-link {% if 'payroll' in request.path %}active{% endif %}">
        <span class="nav-icon">💼</span>
        Payroll
      </a>
    </div>

    <div class="nav-item">
      <a href="{% url 'timesheets:list' %}" class="nav-link {% if 'timesheets' in request.path %}active{% endif %}">
        <span class="nav-icon">⏱️</span>
        Time Tracking
      </a>
    </div>

    <!-- Reports -->
    <div class="nav-section">Reports</div>

    <div class="nav-item">
      <a href="{% url 'reports:profit_loss' %}" class="nav-link {% if 'reports' in request.path %}active{% endif %}">
        <span class="nav-icon">📈</span>
        Reports
      </a>
    </div>

    <!-- Admin only -->
    {% if request.user.is_staff or user_role == 'admin' %}
    <div class="nav-section">Administration</div>

    <div class="nav-item">
      <a href="{% url 'accounts:users' %}" class="nav-link {% if 'users' in request.path %}active{% endif %}">
        <span class="nav-icon">👥</span>
        Users
      </a>
    </div>

    <div class="nav-item">
      <a href="{% url 'company:settings' %}" class="nav-link {% if 'company' in request.path %}active{% endif %}">
        <span class="nav-icon">🏢</span>
        Company
      </a>
    </div>
    {% endif %}

  </nav><!-- /sidebar-nav -->

  <!-- Sidebar Footer: logged-in user -->
  <div class="sidebar-footer">
    <div class="sidebar-user">
      <div class="user-avatar">
        {{ request.user.first_name|first|upper }}{{ request.user.last_name|first|upper }}
      </div>
      <div class="user-info">
        <div class="user-name">{{ request.user.get_full_name|default:request.user.username }}</div>
        <div class="user-role">{{ request.user.profile.get_role_display|default:"User" }}</div>
      </div>
      <!-- Quick logout -->
      <a href="{% url 'accounts:logout' %}" title="Sign out" style="color:var(--sidebar-text);font-size:16px;">⎋</a>
    </div>
  </div>

</aside>